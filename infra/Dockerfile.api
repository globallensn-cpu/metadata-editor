FROM python:3.12-slim-bookworm

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

RUN groupadd -g 10001 reaboard && useradd -u 10001 -g reaboard -s /sbin/nologin reaboard

WORKDIR /app

COPY apps/api/src/ /app/apps/api/src/
COPY apps/worker/src/ /app/apps/worker/src/

RUN pip install fastapi uvicorn pydantic python-multipart httpx

USER reaboard:reaboard

EXPOSE 8000

CMD ["python", "-m", "uvicorn", "apps.api.src.main:app", "--host", "0.0.0.0", "--port", "8000"]
