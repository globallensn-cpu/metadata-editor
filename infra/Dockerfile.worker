FROM python:3.12-slim-bookworm

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    libimage-exiftool-perl \
    qpdf \
    tini \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd -g 10001 reaboard && useradd -u 10001 -g reaboard -s /sbin/nologin reaboard

WORKDIR /app

COPY apps/api/src/ /app/apps/api/src/
COPY apps/worker/src/ /app/apps/worker/src/

RUN pip install pydantic arq redis

USER reaboard:reaboard

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["python", "-m", "apps.worker.src.main"]
