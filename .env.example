# ==============================================================================
# Reaboard Environment Configuration Template
# Privacy-first, lossless-by-default media metadata inspection & removal engine
# ==============================================================================

# Runtime environment (dev, test, prod). In prod, REABOARD_SECRET_KEY must be >= 32 bytes.
REABOARD_ENV=prod

# HMAC secret key used for signed download URLs (Must be at least 32 characters in production)
REABOARD_SECRET_KEY=replace-with-at-least-32-characters-cryptographic-secret-key

# Storage directory for ephemeral files (mounted tmpfs or isolated ephemeral directory)
REABOARD_STORAGE_DIR=/tmp/reaboard

# Redis URL for job state hashes, pub/sub progress events, and ARQ worker queue
REDIS_URL=redis://redis:6379/0

# Maximum allowed upload file size in Megabytes (default: 500 MB)
REABOARD_MAX_UPLOAD_MB=500

# Retention window before ephemeral files and job records are purged (default: 60 minutes)
REABOARD_RETENTION_MINUTES=60

# Upload rate limit per IP per hour (default: 30)
REABOARD_RATE_LIMIT_UPLOADS_PER_HOUR=30

# Allowed CORS origins (comma-separated list, or * for all in development)
REABOARD_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Next.js Internal API URL for server-side rewrites
API_INTERNAL_URL=http://api:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
